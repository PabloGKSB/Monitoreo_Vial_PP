# Copy/configure locally. Never put passwords or tokens in Git or chat.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# Use a dedicated backend DB role and TLS certificate verification.
VIAL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=C:/PATH/TO/ROOT.crt
# Optional separate connection with DDL privileges, used only by run_migrations.py.
# The vial_backend runtime role cannot apply migrations.
# VIAL_MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATOR:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=C:/PATH/TO/ROOT.crt
# With a session pooler (port 5432), use ROLE.PROJECT_REF as the username.
VIAL_API_STORAGE=.api_local/central
VIAL_MAX_JOBS_24H=20
VIAL_MAX_UPLOAD_MB_24H=256
VIAL_MIN_FREE_STORAGE_MB=256
# Bounded clock tolerance (0..120 seconds); synchronize server clocks in production.
VIAL_JWT_LEEWAY_SECONDS=90
# Optional rollback-only runtime checks against an already migrated database.
# VIAL_RUNTIME_TEST_DATABASE_URL=postgresql+psycopg://vial_backend.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=C:/PATH/TO/ROOT.crt
