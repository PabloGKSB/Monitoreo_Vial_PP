SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
VIAL_DATABASE_URL=postgresql+psycopg://vial_backend.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/app/deploy/prod-ca-2021.crt&connect_timeout=10
VIAL_PUBLIC_ORIGIN=https://YOUR_DOMAIN
VIAL_API_STORAGE=/data/archives
VIAL_BACKUP_DIR=/data/backups
# Railway supplies RAILWAY_VOLUME_MOUNT_PATH after attaching the volume at /data.
# Bootstrap only: run_server.py assigns the volume, then drops to uid/gid 10001.
RAILWAY_RUN_UID=0
# For another provider, set VIAL_VOLUME_ROOT=/data instead.
VIAL_PERSISTENT_STORAGE_CONFIRMED=0
WEB_CONCURRENCY=1
VIAL_MAX_JOBS_24H=20
# Small pilot: at most two existing accounts, 30-day originals, 5 GB volume.
# 32 MiB/account/24h is intentional; files over that need an explicit quota review.
VIAL_MAX_UPLOAD_MB_24H=32
VIAL_MIN_FREE_STORAGE_MB=512
VIAL_JWT_LEEWAY_SECONDS=90
# Trust only the reverse proxy; use * only behind an edge that sanitizes headers.
FORWARDED_ALLOW_IPS=127.0.0.1
