+package com.monitoreovial.anotador.capture
+
+import android.app.*
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.hardware.*
+import android.os.*
+import androidx.core.app.NotificationCompat
+import com.monitoreovial.anotador.MainActivity
+import org.json.JSONObject
+import java.io.File
+import java.util.concurrent.atomic.AtomicBoolean
+
+class RecordingService : Service(), SensorEventListener {
+    private val main = Handler(Looper.getMainLooper())
+    private lateinit var thread: HandlerThread
+    private lateinit var collector: Handler
+    private lateinit var manager: SensorManager
+    @Volatile private var writer: ImuSessionWriter? = null
+    private var directory: File? = null
+    private var metadata = JSONObject()
+    private val closing = AtomicBoolean(false)
+    private val completed = AtomicBoolean(false)
+    @Volatile private var destroyed = false
+    private var started = false
+    private var gyroAvailable = false
+    @Volatile private var terminalError: String? = null
+    private val ticker = object : Runnable {
+        override fun run() {
+            publish()
+            if (CaptureState.snapshot.busy) main.postDelayed(this, 500)
+        }
+    }
+
+    override fun onCreate() {
+        super.onCreate()
+        manager = getSystemService(SENSOR_SERVICE) as SensorManager
+        thread = HandlerThread("imu-collector").also { it.start() }
+        collector = Handler(thread.looper)
+        val notifications = getSystemService(NotificationManager::class.java)
+        notifications.createNotificationChannel(NotificationChannel("imu_capture", "Captura de sensores", NotificationManager.IMPORTANCE_LOW))
+        val open = PendingIntent.getActivity(this, 20, Intent(this, MainActivity::class.java), PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+        val notification = NotificationCompat.Builder(this, "imu_capture")
+            .setSmallIcon(android.R.drawable.ic_menu_compass).setContentTitle("Captura IMU activa")
+            .setContentText("Acelerometro y giroscopio; sin GPS").setContentIntent(open).setOngoing(true).build()
+        if (Build.VERSION.SDK_INT >= 34) startForeground(2002, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE)
+        else startForeground(2002, notification)
+        CaptureState.service = this
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (started) return START_NOT_STICKY
+        started = true
+        val path = intent?.getStringExtra("annotations")
+        collector.post {
+            try {
+                require(path != null) { "Missing annotation session" }
+                val annotationFile = File(path)
+                val allowed = getExternalFilesDir(android.os.Environment.DIRECTORY_DOCUMENTS)!!.canonicalFile
+                require(annotationFile.canonicalFile.parentFile == allowed && annotationFile.isFile) { "Invalid session path" }
+                val folder = File(allowed, annotationFile.nameWithoutExtension + "_imu")
+                check(folder.mkdir()) { "Capture folder exists or cannot be created" }
+                directory = folder
+                val acceleration = manager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
+                    ?: error("Acelerometro no disponible")
+                val gyro = manager.getDefaultSensor(Sensor.TYPE_GYROSCOPE)
+                gyroAvailable = gyro != null
+                val origin = SystemClock.elapsedRealtimeNanos()
+                val epoch = System.currentTimeMillis()
+                metadata = JSONObject().put("schema_version", "imu-preview-1")
+                    .put("state", "RECORDING").put("annotations_file", annotationFile.name)
+                    .put("origin_monotonic_ns", origin.toString()).put("origin_epoch_ms", epoch)
+                    .put("requested_period_us", 10000).put("gps_available", false)
+                    .put("accelerometer_semantics", "TYPE_ACCELEROMETER includes gravity, m/s2, device axes")
+                    .put("gyroscope_semantics", "TYPE_GYROSCOPE rad/s, device axes")
+                    .put("accelerometer_name", acceleration.name).put("gyroscope_name", gyro?.name ?: JSONObject.NULL)
+                    .put("device", Build.MODEL).put("android", Build.VERSION.RELEASE)
+                    .put("annotation_semantics", "Retrospective button reference; not impact time")
+                    .put("haptic_feedback_during_capture", false)
+                writeMetadata()
+                val names = if (gyroAvailable) listOf("accelerometer", "gyroscope") else listOf("accelerometer")
+                writer = ImuSessionWriter(folder, origin, epoch, names) { error -> collector.post { complete(error) } }
+                writer!!.start()
+                check(manager.registerListener(this, acceleration, 10000, collector)) { "No se pudo registrar acelerometro" }
+                if (gyro != null) check(manager.registerListener(this, gyro, 10000, collector)) { "No se pudo registrar giroscopio" }
+                main.post { CaptureState.snapshot = CaptureState.snapshot.copy(phase = "Capturando IMU", directory = folder, gyroAvailable = gyroAvailable); main.post(ticker) }
+                main.post { if (CaptureState.stopRequested) finishCapture() }
+            } catch (error: Exception) {
+                terminalError = error.message ?: error.javaClass.simpleName
+                manager.unregisterListener(this)
+                closing.set(true)
+                if (writer != null) writer!!.finish() else complete(terminalError)
+            }
+        }
+        return START_NOT_STICKY
+    }
+
+    override fun onSensorChanged(event: SensorEvent) {
+        if (closing.get()) return
+        val name = when (event.sensor.type) {
+            Sensor.TYPE_ACCELEROMETER -> "accelerometer"
+            Sensor.TYPE_GYROSCOPE -> "gyroscope"
+            else -> return
+        }
+        writer?.offer(ImuSample(name, event.timestamp, event.values[0], event.values[1], event.values[2]))
+    }
+    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) = Unit
+
+    fun finishCapture() {
+        if (!closing.compareAndSet(false, true)) return
+        collector.post {
+            manager.unregisterListener(this)
+            writer?.finish()
+        }
+    }
+
+    private fun publish() {
+        val empty = StreamSummary(0, 0.0, 0.0, 0, 0)
+        CaptureState.snapshot = CaptureState.snapshot.copy(
+            accel = writer?.stats?.get("accelerometer")?.snapshot() ?: empty,
+            gyro = writer?.stats?.get("gyroscope")?.snapshot() ?: empty,
+            dropped = writer?.dropped?.get() ?: 0)
+    }
+
+    private fun complete(error: String?) {
+        if (!completed.compareAndSet(false, true)) return
+        closing.set(true)
+        terminalError = terminalError ?: error
+        manager.unregisterListener(this)
+        try {
+            val w = writer
+            if (w != null && w.stats.getValue("accelerometer").snapshot().count == 0L)
+                terminalError = terminalError ?: "No se recibieron muestras de acelerometro"
+            metadata.put("state", if (terminalError == null) "COMPLETED" else "INCOMPLETE")
+                .put("error", terminalError ?: JSONObject.NULL)
+                .put("queue_dropped", w?.dropped?.get() ?: 0)
+                .put("pending_unwritten", w?.pendingCount() ?: 0)
+            for ((name, stats) in w?.stats.orEmpty()) {
+                val s = stats.snapshot()
+                metadata.put(name + "_quality", JSONObject().put("samples", s.count).put("effective_hz", s.hz)
+                    .put("max_gap_ms", s.maxGapMs).put("gaps_over_100ms", s.gapsOver100Ms).put("non_increasing", s.nonIncreasing))
+            }
+            writeMetadata()
+        } catch (problem: Exception) { terminalError = terminalError ?: problem.message ?: "Metadata failure" }
+        main.post {
+            main.removeCallbacks(ticker)
+            publish()
+            CaptureState.snapshot = CaptureState.snapshot.copy(busy = !destroyed, directory = directory,
+                phase = if (terminalError == null) "IMU guardada" else "IMU incompleta", error = terminalError)
+            stopForeground(STOP_FOREGROUND_REMOVE)
+            stopSelf()
+            if (destroyed) thread.quitSafely()
+        }
+    }
+    private fun writeMetadata() {
+        val dir = directory ?: return
+        val tmp = File(dir, "metadata.json.tmp")
+        tmp.writeText(metadata.toString(2), Charsets.UTF_8)
+        java.nio.file.Files.move(tmp.toPath(), File(dir, "metadata.json").toPath(),
+            java.nio.file.StandardCopyOption.REPLACE_EXISTING, java.nio.file.StandardCopyOption.ATOMIC_MOVE)
+    }
+    override fun onDestroy() {
+        destroyed = true
+        main.removeCallbacks(ticker)
+        if (!completed.get()) { terminalError = "Servicio interrumpido"; finishCapture() }
+        else {
+            CaptureState.snapshot = CaptureState.snapshot.copy(busy = false)
+            thread.quitSafely()
+        }
+        if (CaptureState.service === this) CaptureState.service = null
+        super.onDestroy()
+    }
+    override fun onBind(intent: Intent?): IBinder? = null
+}
